# ──────────────────────────────────────────────────────────────────────────────
# EduCore ERP — Environment variables template
#
# INSTRUCTIONS
#   1. Copy to .env:          cp .env.example .env
#   2. Generate real secrets: bash infra/scripts/generate-secrets.sh >> .env
#   3. NEVER commit .env to version control (it is in .gitignore)
#   4. In production, inject secrets via your host's secret manager or
#      `docker secret` — do NOT hard-code values in docker-compose.yml
#
# CRITICAL: the placeholder JWT secrets below will cause the app to REFUSE
# TO START on production (NODE_ENV=production). Replace them before deploying.
# ──────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000

# PostgreSQL — change DB_PASSWORD in production
DATABASE_URL=postgres://educore:educore@localhost:5432/educore
DB_PASSWORD=educore

# ── JWT Secrets ───────────────────────────────────────────────────────────────
# MUST be replaced with random values before going live.
# Generate:  openssl rand -base64 48
# The Zod validator (config/env.ts) enforces min 32 chars — the app will
# crash at startup if these are left as placeholders in production.
JWT_ACCESS_SECRET=REPLACE_ME_openssl_rand_base64_48
JWT_REFRESH_SECRET=REPLACE_ME_openssl_rand_base64_48_different_value

# Token lifetimes
ACCESS_TTL=15m
REFRESH_TTL_DAYS=7

# CORS — set to your actual frontend origin in production
CORS_ORIGIN=http://localhost:5173

# ── TOTP Secret Encryption Key ────────────────────────────────────────────────
# AES-256-GCM key for encrypting TOTP secrets stored in the database.
# REQUIRED in production. App will refuse to start without it.
# Must be exactly 64 hex characters (32 bytes).
#
# Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# یہ key DB backup سے الگ محفوظ رکھیں (e.g. AWS Secrets Manager / Vault)۔
# اگر یہ key گم ہو جائے تو تمام users کو 2FA re-setup کرنا ہوگا۔
TOTP_ENCRYPTION_KEY=REPLACE_ME_node_-e_crypto_randomBytes_32_hex

# Redis (required for BullMQ job queues + security features)
# Security features using Redis:
#  - JTI blacklist (logout / token revocation)
#  - Challenge token one-time use (SETNX)
#  - Account lockout counter
REDIS_URL=redis://localhost:6379

# ── Communication providers (all optional) ────────────────────────────────────
# Leave blank to disable; the system boots and runs without these.
# Providers return a graceful error when unconfigured.

# Twilio (SMS + WhatsApp)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WHATSAPP_FROM=

# SMTP Email (Nodemailer)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@yourschool.edu
