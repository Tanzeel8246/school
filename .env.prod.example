# Production Environment Variables Template (.env.prod)
# 1. Copy this file: cp .env.prod.example .env.prod
# 2. Fill in the secure values before running docker compose

# Base config
NODE_ENV=production
CORS_ORIGIN=https://erp.example.com

# PostgreSQL configuration
POSTGRES_USER=educore
POSTGRES_DB=educore
POSTGRES_PASSWORD=your_secure_db_password_here

# Redis configuration
REDIS_PASSWORD=your_secure_redis_password_here

# Application Secrets (Must be exactly 32+ characters)
JWT_ACCESS_SECRET=generate_a_secure_32_character_long_secret_here
JWT_REFRESH_SECRET=generate_another_secure_32_character_long_secret_here
TWOFA_SECRET_KEY=generate_another_secure_32_character_long_secret_here

# Vault integration (Optional - if using external secrets manager instead of this file)
# VAULT_ADDR=https://vault.example.com
# VAULT_TOKEN=your_vault_token
